# Configuração NÃO secreta da API na imagem Docker (arquivo versionado).
# Segredos (JWT_*, PASSWORD_PEPPER*, DATABASE_URL) ficam em server/.env.secrets, permissão 600,
# nunca aqui — ver specs/010-autenticacao/deploy.md.
DATABASE_PROVIDER=postgresql
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# CORS_ORIGIN (origem pública do web, conferida no Origin das rotas /auth) vem do docker-compose.yml:
# SMAUG_PUBLIC_ORIGIN, ou http://localhost:<SMAUG_WEB_PORT> por padrão.

# Saltos confiáveis do Express: a sub-rede fixa do compose (networks.default em
# docker-compose.yml), onde só o web chama a API. Máquinas diferentes: o IP do servidor do web.
TRUST_PROXY=10.250.0.0/24

# Cookie do refresh: Secure exige HTTPS na frente do web (proxy reverso / terminador TLS).
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_PATH=/api/auth

JWT_ISSUER=smaug-api
JWT_AUDIENCE=smaug-web
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_MAX_LIFETIME_SECONDS=2592000
REFRESH_REUSE_GRACE_SECONDS=30

# Argon2id: pisos OWASP fora de test (memória >= 19456 KiB, tempo >= 2).
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
