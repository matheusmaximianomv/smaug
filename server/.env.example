DATABASE_PROVIDER=sqlite
# SQLite: caminho relativo a server/ (a pasta deste arquivo)
DATABASE_URL=file:./prisma/sqlite/dev.db
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3001

# Só para `migrate:new` e `migrate:check`: banco PostgreSQL DESCARTÁVEL (é apagado a cada uso).
# Com o Postgres do docker-compose: docker compose up -d postgres
# POSTGRES_SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smaug_shadow

# --- Autenticação ---------------------------------------------------------------------------
# OS VALORES ABAIXO SÃO EXEMPLOS PÚBLICOS E INSEGUROS: nunca os use fora da sua máquina.
# Gere cada segredo com:   openssl rand -base64 32
# (base64 padrão, com o "=" final; precisa decodificar para pelo menos 32 bytes)
JWT_SECRET=SU5TRUdVUk8tZXhlbXBsby1qd3Qtc2VjcmV0LXRyb3F1ZSE=
JWT_KEY_ID=dev-1
# Só durante a rotação da chave do JWT (a anterior passa a só verificar), sempre em par:
# JWT_PREVIOUS_SECRET=
# JWT_PREVIOUS_KEY_ID=
# JWT_ISSUER=smaug-api
# JWT_AUDIENCE=smaug-web
# ACCESS_TOKEN_TTL_SECONDS=600
# REFRESH_TOKEN_TTL_SECONDS=604800
# SESSION_MAX_LIFETIME_SECONDS=2592000
# REFRESH_REUSE_GRACE_SECONDS=30

# Chaveiro de peppers "id:base64,id:base64"; o vigente precisa estar no chaveiro. Perder um pepper
# invalida todas as senhas feitas com ele: guarde backup separado do backup do banco.
PASSWORD_PEPPERS=dev-1:SU5TRUdVUk8tZXhlbXBsby1wZXBwZXItdHJvcXVlLWEh
PASSWORD_PEPPER_CURRENT_ID=dev-1
# Custo do Argon2id (padrões; fora de NODE_ENV=test o mínimo é 19456 KiB e timeCost 2):
# ARGON2_MEMORY_KIB=65536
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=4

# Cookie do refresh token: Secure é ligado por padrão fora de development/test.
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_PATH=/api/auth
# Obrigatório fora de development/test: saltos confiáveis do "trust proxy" do Express (o servidor
# do web), ex.: 1, loopback ou 172.16.0.0/12. "true" é recusado (tornaria o X-Forwarded-For forjável).
# Em development, com o web repassando /api na mesma máquina, use "loopback": sem ele o
# express-rate-limit registra ERR_ERL_UNEXPECTED_X_FORWARDED_FOR a cada chamada repassada.
# TRUST_PROXY=

# Rate limit das rotas /auth: tentativas por janela fixa, contadas pelo IP do cliente (padrões).
# AUTH_RATE_LIMIT_REGISTER_PER_IP=10   # cadastro, por hora
# AUTH_RATE_LIMIT_LOGIN_PER_IP=50      # login, por 15 min
# AUTH_RATE_LIMIT_LOGIN_PER_EMAIL=10   # login, por 15 min, por IP + e-mail normalizado
# AUTH_RATE_LIMIT_REFRESH_PER_IP=60    # renovação, por minuto
