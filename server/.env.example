DATABASE_PROVIDER=sqlite
# SQLite: caminho relativo a server/ (a pasta deste arquivo)
DATABASE_URL=file:./prisma/sqlite/dev.db
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3001

# Só para `migrate:new` e `migrate:check`: banco PostgreSQL DESCARTÁVEL (é apagado a cada uso).
# Com o Postgres do docker-compose: docker compose up -d postgres
# POSTGRES_SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smaug_shadow
