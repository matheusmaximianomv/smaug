# React está fixado num prerelease (19.0.0-rc-...), e no semver do npm `^19.0.0`
# NÃO casa com um prerelease de 19.0.0. Sem esta flag o npm aborta a resolução de
# peers e instala uma árvore SEM os peers (foi assim que @testing-library/dom e
# @testing-library/jest-dom acabaram ausentes, quebrando o vitest.setup.ts).
# TODO: remover quando o React 19 sair de RC e as versões forem estáveis.
legacy-peer-deps=true
